   "changeset": "2026-10-17-grammar-rulings",
   "op": "add_ruling",
   "entry": "1.2:G24",
   "to": "Time words open or close a clause; the opening comma is optional; zafra, finra, lanto, kenvi stay opening-only."
  },
  {
   "changeset": "2026-10-17-grammar-rulings",
   "op": "add_ruling",
   "entry": "1.2:G25",
   "to": "A lone oro joins two equal parts like ata, and may open a continuing clause; oro A oro B is emphatic either/or."
  },
  {
   "changeset": "2026-10-17-grammar-rulings",
   "op": "add_ruling",
   "entry": "1.2:G26",
   "to": "A give-type verb takes THEME ala RECIPIENT, or a bare pronoun recipient straight after the verb."
  },
  {
   "changeset": "2026-10-17-grammar-rulings",
   "op": "add_ruling",
   "entry": "1.2:G27",
   "to": "In X de Y the owner is Y, except a pronoun or personal name before de is the owner; a pronoun is always the owner."
  },
  {
   "changeset": "2026-10-17-grammar-rulings",
   "op": "add_ruling",
   "entry": "1.2:G28",
   "to": "-ri is optional after a number or quantifier."
  },
  {
   "changeset": "2026-10-17-grammar-rulings",
   "op": "add_ruling",
   "entry": "1.2:G29",
   "to": "An adjective stands as a noun only after an article or determiner."
  },
  {
   "changeset": "2026-10-17-grammar-rulings",
   "op": "add_ruling",
   "entry": "1.2:G30",
   "to": "\"About\" is a de phrase; no new word."
