 "rulings": [
  {
   "id": "G1",
   "topic": "Scope by position",
   "ruling": "Every preverbal operator scopes over everything to its right. Pre-constituent operators (ne, doli, tu, yesta, pendi, vinto) scope over the single constituent that follows them."
  },
  {
   "id": "G2",
   "topic": "si and whether",
   "ruling": "si means only 'if'. 'whether' is ki-oro. 0.8 texts that used si for 'whether' are read under 0.8 rules."
  },
  {
   "id": "G3",
   "topic": "Permission vs possibility vs ability",
   "ruling": "povi = ability; nosi = epistemic possibility (might); dagi = permission (may, be allowed). 0.8's double use of nosi is split."
  },
  {
   "id": "G4",
   "topic": "Epistemic necessity",
   "ruling": "'must (logically)' = inferential evidential tosu + seye; musi is only obligation or circumstantial necessity."
  },
  {
   "id": "G5",
   "topic": "Intention",
   "ruling": "Intent is the verb chain 'dorvada sidu VERB' (intend to); kopi is only 'hope to'. Deliberately = la dorvasan; accidentally = la dorvanasan."
  },
  {
   "id": "G6",
   "topic": "Counterfactual",
   "ruling": "noma marks a clause as contrary to fact. 'should have' = po noma suvi; 'could have' = po noma povi; 'would have' = po viki (in a consequence clause) or po noma viki."
  },
  {
   "id": "G7",
   "topic": "Imminence",
   "ruling": "fututi in the approach slot means 'about to': Maivo po fututi pagopa = I was about to leave. As a clause-initial time word it still means 'soon'."
  },
  {
   "id": "G8",
   "topic": "Continuation",
   "ruling": "loki covers both 'still' and 'keep on'; no separate continuative is added."
  },
  {
   "id": "G9",
   "topic": "Quantity limits",
   "ruling": "Before a number or quantity, lusu = at least, mosa = at most, gase = approximately; pendi = exactly."
  },
  {
   "id": "G10",
   "topic": "Paired conjunctions",
   "ruling": "oro A oro B = either A or B; ne A ne B = neither A nor B; doli si = only if; yesta si = even if; 'si …, ata doli si …' = if and only if."
  },
  {
   "id": "G11",
   "topic": "Despite",
   "ruling": "nevi + noun phrase = despite: nevi li zeldo, despite the resistance. nevi + clause = although."
  },
  {
   "id": "G12",
   "topic": "Benefactive",
   "ruling": "vobi + noun phrase = for the benefit of / on behalf of (unchanged), and combines with any operator."
  },
  {
   "id": "G13",
   "topic": "ata",
   "ruling": "ata is 'and' only; additive 'also' is tu."
  },
  {
   "id": "G14",
   "topic": "Valency operators",
   "ruling": "vaku (make), lesvu (let) and tekvu (prevent) fill the verb slot of the main clause; the actor follows, then the actor's own [ne] [phase] [effort] verb. Tense, modal and evidential belong to the main clause only."
  },
  {
   "id": "G15",
   "topic": "Negation and operators",
   "ruling": "ne before an operator negates the operator; ne after it negates the event: po ne vazdi lirala = didn't manage to sing; po vazdi ne lirala = managed not to sing."
  },
  {
   "id": "G16",
   "topic": "Exclusions",
   "ruling": "At most one word per slot. hiro/teki do not combine with roni or tefa. tavki excludes fututi (same slot). The effort slot (telvo, vazdi, fesmo) excludes tefa. noma requires a tense, modal or si-clause context."
  },
  {
   "id": "G17",
   "topic": "Unexpectedly / previously / simultaneously",
   "ruling": "la nerponasan = unexpectedly; kroti ola = previously; nayo ola = meanwhile/simultaneously; krotiapo = subsequently. No new words."
  },
  {
   "id": "G18",
   "topic": "Topic and focus together",
   "ruling": "A hozi-topic opens the clause; vinto may then mark a focus inside it. hozi and vinto never mark the same constituent."
  },
  {
   "id": "G19",
   "topic": "Version gating",
   "ruling": "Texts dated before 1.0 are interpreted with the 0.8 lexicon and rules. A 1.0 reader meeting a retired spelling looks it up in legacy.retired and reads the 1.0 replacement."
  },
  {
   "id": "G20",
   "topic": "Lexicalised derivations",
   "ruling": "tisebitivu (sword), tibivu (rope), kaldopago (prison) and zeldoyo (rebel) are fixed meanings of regular derivations."
  },
  {
   "id": "G21",
   "topic": "Closing a relative clause",
   "ruling": "A raho-clause that does not end the sentence is closed by a comma in writing and a pause in speech: Li sabeyo raho vismava eli, ne yehu vimova li vordu. (Found in stress-testing: without the pause the main verb is read inside the relative clause.)"
  },
  {
   "id": "G22",
   "topic": "Attitude words are clause-final only",
   "ruling": "seye, mufe, poye, pifu and zoke never open a clause. 'Perhaps, …' at the start of a sentence is written with the clause-final poye. (Found in stress-testing.)"
  },
  {
   "id": "G23",
   "topic": "Events taking place",
   "ruling": "venreva (come) with an event as subject means 'take place, happen': Li dapadonu po venreva kroti li nilvu, the sale took place before winter."
  }
 ],
