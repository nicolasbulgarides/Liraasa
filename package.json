{
  "name": "liraasa-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Codex, translator, learning system and language-evolution command center for Liraasa 1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:editor": "tsx scripts/build_editor_data.ts",
    "build:handoff": "tsx scripts/build_handoff.ts",
    "build:guide": "npm run build:handoff && tsx scripts/build_grammar_guide.ts",
    "publish:guide": "tsx scripts/publish_guide.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "tsx scripts/validate.ts",
    "lexicon:import": "tsx scripts/import.ts",
    "lexicon:export": "tsx scripts/export.ts",
    "integrate": "tsx scripts/integrate.ts",
    "report:1.1": "tsx scripts/report_1_1.ts",
    "export:mfa": "tsx scripts/export_mfa.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
