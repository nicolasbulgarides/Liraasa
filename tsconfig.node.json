{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@storage/*": ["src/storage/*"],
      "@ui/*": ["src/ui/*"]
    },
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["scripts", "vite.config.ts", "vitest.config.ts", "eslint.config.js"]
}
